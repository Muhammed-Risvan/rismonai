# Rismon environment variables — names only, never real values in git.
# Real values belong in .env.local (gitignored). Never read/print .env.local.
#
# Supabase auth (browser + server clients use the anon/publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret/service key: test helpers under tests/helpers ONLY. Never used by app code.
SUPABASE_SERVICE_ROLE_KEY=
# App runtime DB connection (Vercel: transaction pooler, port 6543; local: session pooler OK).
DATABASE_URL=
# Migrations only (drizzle-kit): session pooler, port 5432.
DATABASE_MIGRATION_URL=
# Set to "true" to allow DB integration tests to run.
ALLOW_DB_TESTS=
# Planned for a later milestone; unused for now.
AI_PROVIDER_API_KEY=